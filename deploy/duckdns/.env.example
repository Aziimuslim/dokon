# Nusxa oling: cp deploy/duckdns/.env.example deploy/duckdns/.env
# .env fayli GitHub'ga YUKLANMAYDI (.gitignore). Tokenni hech kimga ko'rsatmang.
DOMAIN=reversdokon.duckdns.org
DUCKDNS_SUBDOMAIN=reversdokon
DUCKDNS_TOKEN=duckdns-sahifasidagi-tokeningiz

# Har biriga uzun tasodifiy qiymat yozing: openssl rand -hex 32
# (Windows'da: PowerShell → [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N"))
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ORDER_SIGN_SECRET=
PAYMENT_PROVIDER_SECRET=
